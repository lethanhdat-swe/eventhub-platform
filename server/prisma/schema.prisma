generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

///////////////////////
// USERS
///////////////////////

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  password    String?
  phoneNumber String? @unique @map("phone_number")
  fullName    String  @map("full_name")
  avatarUrl   String? @map("avatar_url")

  role       String  @default("customer")
  provider   String  @default("credentials")
  providerId String? @unique @map("provider_id")

  isEmailVerified Boolean @default(false) @map("is_email_verified")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  orders Order[]

  @@map("users")
}

///////////////////////
// CATEGORY
///////////////////////

model Category {
  id   String @id @default(uuid())
  name String
  slug String @unique

  events Event[]

  @@map("categories")
}

///////////////////////
// EVENTS
///////////////////////

model Event {
  id           String    @id @default(uuid())
  title        String
  slug         String    @unique
  description  String?
  contentHtml  String?   @map("content_html")
  location     String?
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  thumbnailUrl String?   @map("thumbnail_url")

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id])

  status    String   @default("draft")
  createdAt DateTime @default(now()) @map("created_at")

  ticketTypes TicketType[]
  seats       Seat[]
  tickets     Ticket[]

  @@map("events")
}

///////////////////////
// TICKET TYPES
///////////////////////

model TicketType {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id])

  name              String
  price             Float
  totalQuantity     Int?   @map("total_quantity")
  remainingQuantity Int?   @map("remaining_quantity")

  seats   Seat[]
  tickets Ticket[]

  @@map("ticket_types")
}

///////////////////////
// SEATS
///////////////////////

model Seat {
  id           String @id @default(uuid())
  eventId      String @map("event_id")
  ticketTypeId String @map("ticket_type_id")

  event      Event      @relation(fields: [eventId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  rowLabel   String? @map("row_label")
  seatNumber Int?    @map("seat_number")

  status String @default("available")

  ticket Ticket?

  @@map("seats")
}

///////////////////////
// ORDERS
///////////////////////

model Order {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  customerEmail String  @map("customer_email")
  customerPhone String  @map("customer_phone")
  customerName  String? @map("customer_name")

  totalAmount        Float?  @map("total_amount")
  status             String  @default("pending")
  paymentMethod      String  @default("SEPAY") @map("payment_method")
  sepayTransactionId String? @unique @map("sepay_transaction_id")
  orderCode          String? @unique @map("order_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tickets Ticket[]

  @@map("orders")
}

///////////////////////
// TICKETS
///////////////////////

model Ticket {
  id String @id @default(uuid())

  orderId      String @map("order_id")
  eventId      String @map("event_id")
  seatId       String @unique @map("seat_id")
  ticketTypeId String @map("ticket_type_id")

  order      Order      @relation(fields: [orderId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id])
  seat       Seat       @relation(fields: [seatId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  qrSecureToken String @unique @map("qr_secure_token")

  isCheckedIn Boolean   @default(false) @map("is_checked_in")
  checkedInAt DateTime? @map("checked_in_at")

  @@map("tickets")
}

///////////////////////
// COUPONS
///////////////////////

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Int?      @map("discount_percent")
  validUntil      DateTime? @map("valid_until")
  usageLimit      Int?      @map("usage_limit")

  @@map("coupons")
}
